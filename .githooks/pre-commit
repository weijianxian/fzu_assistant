#!/usr/bin/env bash
hook_phase=pre-commit
source "$(dirname -- "${BASH_SOURCE[0]}")/common.sh"

# Only the internal correction takes this route. It still runs this hook, and
# must match the already-created commit and its actual build number.
if [[ -n "${FZU_BUILD_NUMBER_REPAIR:-}" ]]; then
  [[ "$(git rev-parse HEAD)" == "$FZU_BUILD_NUMBER_REPAIR" ]] ||
    fail 'HEAD changed during build-number correction.'
  new_tmp
  git show :pubspec.yaml > "$hook_tmp/pubspec.index"
  [[ "$(read_number "$hook_tmp/pubspec.index")" == "$(build_number)" ]] ||
    fail 'invalid build number in the correction index.'
  exit 0
fi

number=$(build_number 1)
# --only/--include use a second index while Git holds the real index lock.
# Updating both safely is outside this hook's scope; fail before any mutation.
if [[ -n "${GIT_INDEX_FILE:-}" ]]; then
  commit_index=$(realpath -m -- "$GIT_INDEX_FILE")
  normal_index=$(realpath -m -- "$(env -u GIT_INDEX_FILE git rev-parse --git-path index)")
  [[ "$commit_index" == "$normal_index" || "$commit_index" == "$normal_index.lock" ]] ||
    fail 'temporary commit indexes (including git commit --only) are unsupported; stage the desired files and use git commit. Index and worktree were not changed.'
fi
# Without a staged change an ordinary commit must remain empty. This also
# avoids a redundant amend/signature for a message-only or no-op amend.
if git diff --cached --quiet; then
  exit 0
fi
require_fully_staged pubspec.yaml
files=(pubspec.yaml)
while IFS= read -r -d '' path; do
  require_fully_staged "$path"
  files+=("$path")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.dart')

# Prepare every result before changing any worktree/index content.
new_tmp
write_number pubspec.yaml "$hook_tmp/0.new" "$number"
for ((i = 1; i < ${#files[@]}; i++)); do
  dart format --output=show --summary=none --stdin-name "${files[i]}" \
    < "${files[i]}" > "$hook_tmp/$i.new" ||
    fail "dart format failed: ${files[i]}"
done

changed=()
for ((i = 0; i < ${#files[@]}; i++)); do
  if ! cmp -s -- "${files[i]}" "$hook_tmp/$i.new"; then
    cp -- "${files[i]}" "$hook_tmp/$i.original"
    cat -- "$hook_tmp/$i.new" > "${files[i]}"
    changed+=("${files[i]}")
  fi
done
if ((${#changed[@]})); then
  git add -- "${changed[@]}"
fi
