#!/usr/bin/env bash
hook_phase=post-commit
source "$(dirname -- "${BASH_SOURCE[0]}")/common.sh"

number=$(build_number)
new_tmp
git show HEAD:pubspec.yaml > "$hook_tmp/pubspec.committed"
if [[ "$(read_number "$hook_tmp/pubspec.committed")" == "$number" ]]; then
  exit 0
fi
[[ -z "${FZU_BUILD_NUMBER_REPAIR:-}" ]] ||
  fail 'recursive correction still has an incorrect build number.'

original=$(git rev-parse HEAD)
blob=$(git rev-parse HEAD:pubspec.yaml)
require_fully_staged pubspec.yaml
[[ "$(git rev-parse :pubspec.yaml)" == "$blob" ]] ||
  fail 'pubspec.yaml has staged changes after the commit; correction was not attempted.'
cp -- pubspec.yaml "$hook_tmp/pubspec.original"
write_number "$hook_tmp/pubspec.original" "$hook_tmp/pubspec.worktree" "$number"
write_number "$hook_tmp/pubspec.committed" "$hook_tmp/pubspec.corrected" "$number"
corrected=$(git hash-object -w --stdin < "$hook_tmp/pubspec.corrected")
mode=$(git ls-tree HEAD -- pubspec.yaml | cut -d ' ' -f 1)

# A private index prevents unrelated staged content from entering the amend.
GIT_INDEX_FILE="$hook_tmp/index" git read-tree HEAD
GIT_INDEX_FILE="$hook_tmp/index" git update-index --cacheinfo "$mode,$corrected,pubspec.yaml"
sign=(--no-gpg-sign)
git cat-file commit HEAD > "$hook_tmp/commit"
sed '/^$/q' "$hook_tmp/commit" > "$hook_tmp/headers"
if grep -q '^gpgsig ' "$hook_tmp/headers"; then
  sign=(-S)
fi

# Git calls post-merge after writing the commit, before removing MERGE_HEAD.
# Hide only that backed-up marker while amending the completed merge. The EXIT
# trap restores it so the outer merge can perform its normal cleanup.
if [[ "${FZU_HOOK_POST_MERGE:-}" == 1 ]]; then
  marker=$(git rev-parse --git-path MERGE_HEAD)
  if [[ -f "$marker" ]]; then
    [[ "$(git rev-parse HEAD^2)" == "$(head -n 1 "$marker")" ]] ||
      fail 'MERGE_HEAD does not match the completed merge.'
    cp -- "$marker" "$hook_tmp/MERGE_HEAD"
    merge_marker=$marker
    rm -- "$marker"
  fi
fi
GIT_INDEX_FILE="$hook_tmp/index" FZU_BUILD_NUMBER_REPAIR="$original" \
  git commit --amend --no-edit "${sign[@]}" ||
  fail 'could not amend the build number; signing/commit errors are never bypassed.'

# Nested hooks must not have changed the real pubspec/index in the meantime.
require_fully_staged pubspec.yaml
[[ "$(git rev-parse :pubspec.yaml)" == "$blob" ]] ||
  fail 'pubspec.yaml changed during correction; recovery files were retained.'
git update-index --cacheinfo "$mode,$corrected,pubspec.yaml"
cat -- "$hook_tmp/pubspec.worktree" > pubspec.yaml
printf 'FZU hooks: corrected build number to %s; final HEAD is %s.\n' \
  "$number" "$(git rev-parse --short HEAD)"
