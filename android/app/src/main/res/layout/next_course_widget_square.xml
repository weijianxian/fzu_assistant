<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/widget_next_course_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_heading" style="@style/WidgetCourse.Label"
            android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/widget_next_class" android:textColor="@color/widget_accent"/>
        <ImageButton android:id="@+id/widget_refresh" style="@style/WidgetCourse.Refresh"
            android:layout_width="28dp" android:layout_height="28dp" android:padding="6dp"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_course" style="@style/WidgetCourse.Text"
        android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"
        android:textSize="18sp" android:textStyle="bold" android:maxLines="2"
        android:text="@string/widget_sign_in"/>
    <TextView android:id="@+id/widget_time" style="@style/WidgetCourse.Text"
        android:textSize="13sp" android:visibility="gone"/>
    <TextView android:id="@+id/widget_location" style="@style/WidgetCourse.Caption"
        android:layout_marginTop="2dp" android:textSize="11sp" android:visibility="gone"/>
    <TextView android:id="@+id/widget_date" style="@style/WidgetCourse.Caption"
        android:layout_marginTop="3dp" android:textSize="10sp"/>
    <TextView android:id="@+id/widget_status" style="@style/WidgetCourse.Label" android:visibility="gone"/>
    <TextView android:id="@+id/widget_updated" style="@style/WidgetCourse.Caption" android:visibility="gone"/>
</LinearLayout>
