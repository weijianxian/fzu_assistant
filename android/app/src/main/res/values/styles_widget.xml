<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetCourse.Text" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/widget_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="WidgetCourse.Label" parent="WidgetCourse.Text">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="WidgetCourse.Caption" parent="WidgetCourse.Text">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/widget_secondary</item>
    </style>
    <style name="WidgetCourse.Refresh" parent="">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:padding">7dp</item>
        <item name="android:background">@drawable/widget_refresh_background</item>
        <item name="android:src">@drawable/ic_widget_refresh</item>
        <item name="android:contentDescription">@string/widget_refresh</item>
    </style>
</resources>
